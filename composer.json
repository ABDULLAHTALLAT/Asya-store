{
    "name": "asya/store",
    "type": "project",
    "require": { "php": "^8.2", "laravel/framework": "^12.0" },
    "require-dev": { "laravel/pint": "^1.13", "phpunit/phpunit": "^11.5", "fakerphp/faker": "^1.23" },
    "autoload": { "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" }, "files": ["app/helpers.php"] },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
